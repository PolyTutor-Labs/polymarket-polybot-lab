# Local secrets — never commit filled env files or key material
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_rsa.*
*.p12
*.pfx
wallet.json
mnemonic.txt
credentials.json
.secrets/

# Trading state: the store holds order/fill/PnL history and the
# persisted risk-gate state. Never publish it.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Operational files
KILL_SWITCH
*.log

# Python build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
